        "slash_active": 3,
        "slash_recovery": 20,
        "slash_damage": 54
      },
      "rules": [
        "楔碰撞和过期按逻辑 tick 更新",
        "瞬移落点做边界与对手身体校正，不默认跨过墙",
        "两次伤害分别有命中 ID，瞬移无默认全程无敌",
        "落空/防御仍付收招，效果不能扩大逻辑盒"
      ]
    },
    "Q": {
      "concept": "短起手后先判定命中；命中后多方向斩影，单次总伤害",
      "proposal": {
        "startup": 10,
        "active": 3,
        "recovery": 26,
        "damage": 180,
        "confirmed_cinematic_ticks": 72
      },
      "rules": [
        "命中后短演出，最终结算一次",
        "落空或防御不进入完整演出",
        "斩影只画少量剪影/剑路，不创建完整多个人物"
      ]
    },
    "throw": {
      "concept": "近身抓腕、转体牵引、低位摔出；对手独立被投序列",
